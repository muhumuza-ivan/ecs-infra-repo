        </mxCell>
        <mxCell id="e5" value="&#9400; provisions VPC, ALB, ECS, pipeline, CodeDeploy, EventBridge rule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E73B8;strokeWidth=2;dashed=1;fontSize=9;fontColor=#2E73B8;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfn" target="vpc">
          <mxGeometry relative="1" as="geometry" />
