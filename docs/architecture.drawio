        <!-- Routing strip -->
        <mxCell id="s3gw" value="S3 gateway&lt;br&gt;endpoint" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoint;" vertex="1" parent="1">
          <mxGeometry x="140" y="1400" width="46" height="46" as="geometry" />
        </mxCell>
        <mxCell id="routeNote" value="&lt;b&gt;Public route table&lt;/b&gt; &#8212; 0.0.0.0/0 &#8594; Internet Gateway (both public subnets)&#160;&#160;&#160;&#124;&#160;&#160;&#160;&lt;b&gt;Private route tables 1 &amp;amp; 2&lt;/b&gt; &#8212; local only. &lt;b&gt;No 0.0.0.0/0 route and no NAT Gateway.&lt;/b&gt;&lt;br&gt;&lt;b&gt;S3 gateway endpoint&lt;/b&gt; is attached to both private route tables &#8212; this is the path for ECR image layer blobs, which live in S3. Interface endpoints (ecr.api, ecr.dkr, logs) cover the API calls.&lt;br&gt;&lt;i&gt;Net effect: the tasks pull images and ship logs without ever traversing the public internet, and there is no NAT hourly or per-GB charge.&lt;/i&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF7FF;strokeColor=#8C4FFF;fontSize=9;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="1390" width="1400" height="70" as="geometry" />
        </mxCell>

        <!-- ============ LEGEND ============ -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&#160;&#160;&#8212;&#160;&#160;&lt;font color=&quot;#D45B07&quot;&gt;&#9644;&#9644;&lt;/font&gt; application delivery flow (steps &#9312;&#8211;&#9319;)&#160;&#160;&#183;&#160;&#160;&lt;font color=&quot;#2E73B8&quot;&gt;&#9644;&#9644;&lt;/font&gt; infrastructure provisioning (steps &#9398;&#8211;&#9400;)&#160;&#160;&#183;&#160;&#160;&lt;font color=&quot;#1E8E3E&quot;&gt;&#9644;&#9644;&lt;/font&gt; user request path&#160;&#160;&#183;&#160;&#160;&lt;font color=&quot;#7D8998&quot;&gt;&#9476;&#9476;&lt;/font&gt; private AWS service access via VPC endpoints&lt;br&gt;Zone 2 mirrors Zone 1; its service-access arrows are omitted so the diagram stays readable. Groups are drawn as backdrops &#8212; shapes are absolutely positioned, so moving a group does not move its contents." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F6F8;strokeColor=#5A6C86;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1560" width="1700" height="60" as="geometry" />
        </mxCell>

