        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="lab-app &#8212; ECS Fargate blue/green delivery architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Provisioned by CloudFormation nested stacks. Region eu-west-1. No NAT Gateway &#8212; private subnets reach AWS services over VPC endpoints only." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C86;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1100" height="20" as="geometry" />
        </mxCell>

        <!-- ============ GITHUB (outside AWS) ============ -->
