        <mxCell id="pipeStages" value="&lt;b&gt;Source stage&lt;/b&gt;&#160;AppSource (S3) + ECRSource (:latest)&#160;&#160;&#8594;&#160;&#160;&lt;b&gt;Deploy stage&lt;/b&gt;&#160;CodeDeployToECS&lt;br&gt;&lt;i&gt;PollForSourceChanges: false &#8212; EventBridge is the only trigger. Image1ContainerName substitutes &amp;lt;IMAGE1_NAME&amp;gt; in taskdef.json.&lt;/i&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B0B7C3;fontSize=9;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
