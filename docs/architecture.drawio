        </mxCell>
        <mxCell id="ghActions" value="GitHub Actions &#183; OIDC federation to IAM &#183; no long-lived AWS keys stored in either repo&lt;br&gt;&lt;i&gt;Full role ARN held in one repo secret; account ID resolved at run time via sts:GetCallerIdentity&lt;/i&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAEDF2;strokeColor=#5A6C86;dashed=1;fontSize=10;align=center;" vertex="1" parent="1">
