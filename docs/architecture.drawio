        <!-- ============ EDGES: application delivery (orange) ============ -->
        <mxCell id="e6" value="OIDC &#183; AssumeRoleWithWebIdentity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D45B07;strokeWidth=2;fontSize=9;fontColor=#D45B07;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="ghApp" target="iamApp">
