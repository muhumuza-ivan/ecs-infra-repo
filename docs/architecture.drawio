        <mxCell id="sgNoteA" value="&lt;b&gt;Interface endpoints&lt;/b&gt; (ENIs in this subnet)&lt;br&gt;Endpoint SG: ingress :443 from 10.0.0.0/16&lt;br&gt;&lt;b&gt;ECS task SG&lt;/b&gt;: ingress :8080 from ALB SG only&lt;br&gt;AssignPublicIp: DISABLED" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B0B7C3;fontSize=9;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
