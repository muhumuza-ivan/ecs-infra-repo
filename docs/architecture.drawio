        <mxCell id="e13" value="&#9317; CodeDeployToECS&lt;br&gt;registers task definition" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D45B07;strokeWidth=2;fontSize=9;fontColor=#D45B07;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cp" target="cd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="&#9318; launch replacement task set,&lt;br&gt;register with green TG, wait for healthy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D45B07;strokeWidth=2;fontSize=9;fontColor=#D45B07;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cd" target="tgGreen">
          <mxGeometry relative="1" as="geometry" />
