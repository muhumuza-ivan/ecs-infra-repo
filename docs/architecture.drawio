        <mxCell id="sgNoteB" value="&lt;b&gt;Interface endpoints&lt;/b&gt; (ENIs in this subnet)&lt;br&gt;Same SG rules as Zone 1.&lt;br&gt;&lt;i&gt;Service traffic arrows omitted here for clarity &#8212; this zone mirrors Zone 1.&lt;/i&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B0B7C3;fontSize=9;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1185" width="240" height="82" as="geometry" />
